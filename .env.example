# Optional. Receives each consultation as JSON, including the lead id.
# Point this at your email provider or CRM. Leads are also stored in Netlify Blobs.
LEAD_WEBHOOK_URL=

# Required for live Google Business Profile reviews (/api/reviews).
# Server-side only — never expose this in client code. Create a key in Google Cloud
# with the "Places API" enabled and restrict it to that API.
GOOGLE_PLACES_API_KEY=

# Optional. Google Place ID for the business. Defaults to the verified
# RT Signature Homes Place ID (ChIJ_Q1Bt8ptkFQR8mUyVjwRnvA) when unset.
GOOGLE_PLACE_ID=
